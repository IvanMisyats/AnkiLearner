# AnkiLearner production environment.
#
# On the VPS this lives at /srv/ankilearner/deploy/app.env, owned root:anki mode 0640 —
# the app user reads it, only root can change it. Copy real values from 1Password; never commit
# them (see the private infra repo's SECRETS.md for which item holds what).
#
#   sudo install -o root -g anki -m 0640 /dev/null /srv/ankilearner/deploy/app.env
#   sudo nano /srv/ankilearner/deploy/app.env

# ── Database ─────────────────────────────────────────────────────────
# Superuser, used only by db-setup and by backups.
POSTGRES_ROOT_PASSWORD=
# The application's own non-superuser role — this is what the API connects as.
ANKILEARNER_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────
# At least 32 characters and UNIQUE to this instance. Generate with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Leave false on a private instance. Flip to true only long enough to create the accounts,
# then set it back and redeploy.
ALLOW_REGISTRATION=false

# ── Optional integrations ────────────────────────────────────────────
# AI word lookup. The feature degrades gracefully when this is empty.
ANTHROPIC_API_KEY=

# ── Deployment ───────────────────────────────────────────────────────
# Normally `latest`. To roll back, set this to a specific build tag (e.g. sha-1a2b3c4)
# and run /usr/local/bin/anki-deploy. Every CI build publishes both tags.
IMAGE_TAG=latest
