# AnkiLearner production environment — the ONE file to edit for any production setting.
#
# On the VPS this lives at /srv/ankilearner/deploy/app.env, owned root:anki mode 0640 —
# the app user reads it, only root can change it. Copy real values from 1Password; never commit
# them (see the private infra repo's SECRETS.md for which item holds what).
#
#   sudo install -o root -g anki -m 0640 /dev/null /srv/ankilearner/deploy/app.env
#   sudo nano /srv/ankilearner/deploy/app.env
#
# Edits apply on their own within 5 minutes (anki-deploy.timer notices the changed config and
# recreates only what it affects). To apply at once:
#   sudo machinectl shell anki@ /usr/local/bin/anki-deploy

# ── AI word lookup ───────────────────────────────────────────────────
# Claude API key (platform.claude.com → Settings → API keys). Empty ⇒ AI lookup is switched off.
ANTHROPIC_API_KEY=
# Any Claude model id; omit for the default (claude-haiku-5-5). Model ids:
# https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL=claude-haiku-5-5
# Thinking depth: low (default, fastest) | medium | high | xhigh | max.
# `default` sends none: required for models without effort support, e.g. claude-haiku-4-5.
ANTHROPIC_EFFORT=low

# ── Auth ─────────────────────────────────────────────────────────────
# At least 32 characters and UNIQUE to this instance. Generate with:
#   openssl rand -base64 48
# Changing it signs everyone out.
JWT_SIGNING_KEY=

# Leave false on a private instance. Flip to true only long enough to create the accounts,
# then set it back.
ALLOW_REGISTRATION=false

# ── Deployment ───────────────────────────────────────────────────────
# Normally `latest`. To roll back, set this to a specific build tag (e.g. sha-1a2b3c4).
# Every CI build publishes both tags.
IMAGE_TAG=latest

# ── Database ─────────────────────────────────────────────────────────
# Superuser, used only by db-setup and by backups. Set once at install: Postgres keeps the
# password it was initialised with, so changing it here later only breaks db-setup and backups.
POSTGRES_ROOT_PASSWORD=
# The application's own non-superuser role — this is what the API connects as. Rotatable:
# db-setup re-applies it to the role before the API restarts.
ANKILEARNER_PASSWORD=
