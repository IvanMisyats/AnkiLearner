# AnkiLearner backup credentials.
#
# On the VPS: /srv/ankilearner/backup/backup.env, owned anki:anki mode 0600.
# DO NOT COMMIT REAL VALUES — they live in 1Password (see the private infra repo's SECRETS.md).
#
# Every value here must be DIFFERENT from QuestionsHub's, which shares the same VPS:
#   * its own bucket,
#   * its own S3 access key scoped to that bucket,
#   * its own RESTIC_PASSWORD.
# This is required rather than tidy — each app's snapshot contains that app's app.env, so a
# shared repository would hand one application's secrets to whoever holds the other's key.

# OVH Object Storage (S3) credentials — Anki bucket only
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_DEFAULT_REGION="de"

# OVH endpoint + bucket (fill the bucket name once it is created)
export OVH_S3_ENDPOINT="https://s3.de.io.cloud.ovh.net"
export OVH_S3_BUCKET=""

# restic repository encryption password (client-side).
# This repository is NEW, so it does need `restic init` once — unlike QuestionsHub's, which
# already exists. Losing this value means the backups are unrecoverable.
export RESTIC_PASSWORD=""

# Optional monitoring (Healthchecks.io)
export HC_URL=""
